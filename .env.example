# Copy this file to .env and fill in your keys
# .env is gitignored and will NOT be committed

# OMDB API key — get one free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-key-here

# TMDb API key (optional, enables higher-quality movie/show metadata) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RAWG API key (optional, enables richer game data) — https://rawg.io/apidocs
RAWG_API_KEY=

# JWT secret for auth tokens — use a long random string in production
JWT_SECRET=change-this-in-production

# PostgreSQL database URL (optional — if not set, JSON files are used for local dev)
# DATABASE_URL=postgresql://user:password@host:5432/dbname